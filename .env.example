# IntentShield Configuration
# Copy this file to .env and fill in your API keys

# LLM Judge (OpenAI-compatible API)
INTENT_SHIELD_LLM_KEY=sk-your-openai-api-key
INTENT_SHIELD_LLM_BASE_URL=https://api.openai.com/v1
INTENT_SHIELD_LLM_MODEL=gpt-4o-mini

# Embedding & Reranking (SiliconFlow)
INTENT_SHIELD_EMBED_KEY=sf-your-siliconflow-api-key
INTENT_SHIELD_EMBED_BASE_URL=https://api.siliconflow.cn/v1
INTENT_SHIELD_EMBED_MODEL=BAAI/bge-m3
INTENT_SHIELD_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
